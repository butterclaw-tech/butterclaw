# =============================================
# ButterClaw v0.6.5 — Environment Configuration
# =============================================
# Copy this file to .env and customize values.
#
# Priority order:
#   1. Environment variables (highest — Docker, systemd, shell)
#   2. .env file values (this file, after copying to .env)
#   3. Hardcoded defaults (lowest — match v0.6.2 behavior)
#
# .env values NEVER override existing environment variables.
# This is correct 12-factor behavior — Docker/systemd env vars win.
#
# Docker:   values injected via docker-compose.yml env_file
# systemd:  values injected via EnvironmentFile=/etc/butterclaw.env
# Bare-metal: source .env or export manually
#
# All variable names are prefixed with BUTTERCLAW_ to avoid
# collision with system environment variables.

# =============================================
# SERVER
# =============================================

# Bind address. 0.0.0.0 = all interfaces (Docker/production).
# Use 127.0.0.1 to restrict to localhost only.
BUTTERCLAW_HOST=0.0.0.0

# HTTP port for the Flask application.
# Docker: internal container port (nginx proxies to this).
# Bare-metal: the port you access directly or via reverse proxy.
BUTTERCLAW_PORT=5000

# Debug mode. NEVER enable in production — exposes stack traces.
# Set to 'true' only for local development.
BUTTERCLAW_DEBUG=false

# =============================================
# INSTANCE IDENTITY
# =============================================

# Unique name for this deployment. Appears in:
#   - /api/health responses
#   - Alert payloads (webhook, Discord, ntfy, email, Gotify)
#   - Boot banner
# Set a unique name per deployment to distinguish prod/staging/dev.
BUTTERCLAW_INSTANCE_ID=butterclaw-prod

# =============================================
# DATABASE
# =============================================

# Path to the SQLite database file.
# Default: ./butterclaw.db (same directory as server.py)
#
# Docker: mount a volume and point here for persistence.
#   volumes: butterclaw-data:/data
   BUTTERCLAW_DB_PATH=/data/butterclaw.db
#
# Contains: logs, mcp_events, policies, policy_events,
#           alert_channels, alert_rules, alert_history,
#           api_keys (auth.py), vault keys (buttervault.py)
#
# All 5 modules (server.py, auth.py, policy_engine.py,
# alert_dispatcher.py, buttervault.py) read this single path.
# BUTTERCLAW_DB_PATH=/data/butterclaw.db

# =============================================
# CORS ORIGINS
# =============================================

# Comma-separated list of allowed origins for dashboard access.
# Required for the browser dashboard to communicate with the API.
#
# Docker with nginx: use your domain.
# Bare-metal with reverse proxy: use your domain.
# Local development: defaults cover localhost:5000 and :5500.
#
# BUTTERCLAW_CORS_ORIGINS=https://butterclaw.yourdomain.com,http://localhost:5000

# =============================================
# BRAIN / OLLAMA
# =============================================

# Base URL for the Ollama inference server.
# Docker: use the service name as hostname (e.g., http://ollama:11434)
# Bare-metal: default localhost works if Ollama runs on same machine.
#BUTTERCLAW_OLLAMA_URL=http://localhost:11434
# Docker:
BUTTERCLAW_OLLAMA_URL=http://host.docker.internal:11434

# Ollama API path. Rarely needs changing.
BUTTERCLAW_OLLAMA_PATH=/api/chat

# =================================
# ButterClaw Local Brain ----------
# =================================

# Model name for the Guardian Brain.
# Must be pre-pulled in Ollama: ollama pull <model>
#
# If using the ButterClaw Modelfile:
# Must be pre-pulled in Ollama: ollama pull Modelfile.example
BUTTERCLAW_MODEL=butterclaw-optimized:latest

# ================================
# ButterClaw Remote Brain --------
# ================================

# ---> Enter API Key Here <---
BUTTERCLAW_GOOGLE_API_KEY=your-api-key-here...

# Model name for the Guardian Brain, using Gemini API
# ---> suggested 2.5 flash, 2.5 flash lite (RPM usage allowances) <---
#BUTTERCLAW_MODEL=gemini-3.1-flash-lite

# ================================
# ButterClaw API Key  --------
# Boot auto-healing for watcher and alert_dispatcher(ntfy)
# ================================

# Infrastructure Badge - Self-Healing for watcher
BUTTERCLAW_API_KEY=your-secure-api-key                       # <--- choose custom watcher boot key to auto-heal

# --- ALERT DISPATCHER --- ntfy
BUTTERCLAW_ALERT_NTFY_TOPIC=your-secret-topic-name           # <--- choose a topic name to use in ntfy

#====================================================================
# ButterClaw Confidence Threshold / MCP Tool Inhibitor (for Testing) 
# ===================================================================

# Minimum confidence (0-100) required for CRITICAL verdicts.
# Below this threshold, CRITICAL is downgraded to WARNING
# to prevent self-DoS from low-confidence overreactions.
BUTTERCLAW_CONFIDENCE_THRESHOLD=85

# ===================================================================
# Execution Safety Settings
# ===================================================================

# Kinetic Dry Run: When true, the MCP layer (butterclaw_mcp.py) 
# blocks real TCP connections and system commands. 
# Keep TRUE to prevent accidental system-wide kill-switches.
BUTTERCLAW_MCP_DRY_RUN=true

# Dry-run mode. When true, ChainExecutor simulates tool calls
# without actually executing them. Brain still reasons normally.
# Useful for testing policy rules without real MCP tool execution.
BUTTERCLAW_DRY_RUN=true

# =============================================
# MCP TRANSPORT
# =============================================

# Transport mode for the MCP Execution Layer.
#   stdio — Local child process (default, recommended for single-node)
#   sse   — Remote SSE transport (for distributed setups)
BUTTERCLAW_MCP_TRANSPORT=stdio

# Path to the MCP server script (stdio transport only).
# Default: ./butterclaw_mcp.py (same directory as server.py)
# BUTTERCLAW_MCP_SCRIPT=./butterclaw_mcp.py

# Remote MCP SSE server URL (sse transport only).
# BUTTERCLAW_MCP_SSE_URL=http://remote-mcp:8080

# Bearer token for authenticating with the remote MCP SSE server.
# BUTTERCLAW_MCP_SSE_TOKEN=your-token-here

# =============================================
# AUTHENTICATION
# =============================================

# Rate limits per minute by role tier.
# Requests beyond the limit return 429 Too Many Requests.
BUTTERCLAW_RATE_ADMIN=30
BUTTERCLAW_RATE_OPERATOR=15
BUTTERCLAW_RATE_VIEWER=5

# Session token TTL in seconds.
# Tokens are HMAC-signed with the ButterVault master key.
# Gibson destruction invalidates all sessions automatically.
BUTTERCLAW_SESSION_TTL=3600

# =============================================
# ALERT DISPATCHER
# =============================================

# HTTP timeout (seconds) for outbound alert deliveries.
# Applies to webhook, Discord, ntfy, and Gotify channels.
BUTTERCLAW_ALERT_TIMEOUT=10

# Maximum retry attempts for failed alert deliveries.
# Retries use exponential backoff (1s, 2s, 4s by default).
BUTTERCLAW_ALERT_RETRIES=3

# Base backoff interval (seconds) for alert retries.
# Actual delays: base, base*2, base*4 (exponential).
BUTTERCLAW_ALERT_BACKOFF=1

# Auth brute-force detection threshold.
# Number of 401/403 responses from one IP before firing
# an auth_brute_force alert.
BUTTERCLAW_AUTH_FAIL_THRESHOLD=5

# Sliding window (seconds) for auth failure tracking.
# Failures older than this are pruned from the tracker.
BUTTERCLAW_AUTH_FAIL_WINDOW=60

# =============================================
# OAUTH
# =============================================

# Time-to-live (seconds) for OAuth state tokens.
# State tokens are used during the OAuth callback flow.
# Expired tokens are pruned automatically.
BUTTERCLAW_OAUTH_TTL=600

# -----

# Python Output in Docker Terminal
PYTHONUNBUFFERED=1

# ==========================================
# BUTTERCLAW PARANOIA DIAL
# ==========================================
# 1 = Observe Mode (Log threats, kinetics disabled)
# 2 = Active Defense (SIGKILL compromised processes, keep vault sealed)
# 3 = Air-Gapped Lockdown (SIGKILL + Shred Vault / Global Token Revocation)
BUTTERCLAW_PARANOIA=2