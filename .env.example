# ======================================================
# ButterClaw v0.9.2 -- Example Environment Configuration
# ======================================================
# Copy this file to .env and replace placeholders with actual values,
# or run `python -m butterclaw.setup_wizard` for interactive configuration.

# --- Instance Identity ---
BUTTERCLAW_INSTANCE_ID=butterclaw-prod

# --- Server ---
BUTTERCLAW_HOST=0.0.0.0
BUTTERCLAW_PORT=5000
BUTTERCLAW_DEBUG=false
BUTTERCLAW_BASE_URL=https://localhost
# Disable COOKIE_SECURE only for plain-HTTP local dev
BUTTERCLAW_COOKIE_SECURE=true

# --- Database ---
# Use /data/butterclaw.db for Docker, ./butterclaw.db for local
BUTTERCLAW_DB_PATH=/data/butterclaw.db
# v0.9.0: Fleet DB -- separate file, never co-transacted with butterclaw.db (I-07-fleet)
# Use /data/fleet.db for Docker, ./fleet.db for local
BUTTERCLAW_FLEET_DB_PATH=/data/fleet.db

# --- CORS ---
# Comma-separated list of allowed browser origins
# BUTTERCLAW_CORS_ORIGINS=https://butterclaw.yourdomain.com

# --- Brain / Ollama (Local) ---
# Use http://host.docker.internal:11434 for Docker, http://localhost:11434 for baremetal
BUTTERCLAW_OLLAMA_URL=http://host.docker.internal:11434
BUTTERCLAW_OLLAMA_PATH=/api/chat
BUTTERCLAW_MODEL=butterclaw-optimized:latest

# --- Remote Brain (Google Gemini) ---
# Uncomment and set this to use Google Gemini instead of Ollama
# BUTTERCLAW_GOOGLE_API_KEY=your_google_api_key_here

# --- API Keys ---
# Generate a secure 32+ character string for your bootstrap admin key
BUTTERCLAW_API_KEY=bc_your_secure_random_string_here
# Choose a secret string for ntfy push notifications
BUTTERCLAW_ALERT_NTFY_TOPIC=butterclaw-your-secret-topic

# --- Confidence & Safety ---
BUTTERCLAW_CONFIDENCE_THRESHOLD=85
BUTTERCLAW_MCP_DRY_RUN=true
BUTTERCLAW_DRY_RUN=true
BUTTERCLAW_LOOP_DRY_RUN=true

# --- Dual Memory Engine ---
# Auto-crystallize recurring zero-day spatial patterns (3-strike rule)
BUTTERCLAW_LIVE_CRYSTALLIZATION_ENABLED=true
# Days before low-confidence attractors decay from Cold Memory
BUTTERCLAW_ATTRACTOR_DECAY_DAYS=30

# --- Paranoia Dial ---
# 1=Observe  2=Active Defense  3=Air-Gapped Lockdown
BUTTERCLAW_PARANOIA=2

# --- MCP Transport ---
# Options: stdio, sse
BUTTERCLAW_MCP_TRANSPORT=stdio
# BUTTERCLAW_MCP_SCRIPT=./butterclaw_mcp.py  # Dynamically resolved in src/ layout
# BUTTERCLAW_MCP_SSE_URL=https://remote-mcp-server.com/sse  # Required if transport=sse
# BUTTERCLAW_MCP_SSE_TOKEN=your_sse_bearer_token  # Required if transport=sse

# --- Authentication ---
BUTTERCLAW_RATE_ADMIN=30
BUTTERCLAW_RATE_OPERATOR=15
BUTTERCLAW_RATE_VIEWER=5
BUTTERCLAW_RATE_INFRASTRUCTURE=1000
BUTTERCLAW_SESSION_TTL=3600
BUTTERCLAW_OAUTH_TTL=600

# --- Alert Dispatcher ---
BUTTERCLAW_ALERT_TIMEOUT=10
BUTTERCLAW_ALERT_RETRIES=3
BUTTERCLAW_ALERT_BACKOFF=1
BUTTERCLAW_AUTH_FAIL_THRESHOLD=5
BUTTERCLAW_AUTH_FAIL_WINDOW=60

# --- Fleet Layer (v0.9.0) ---
# Fleet Sentinel dry-run: true = log verdicts only, no Guardian Brain escalation.
# Follow the RUNBOOK dry-run rollout procedure before setting to false.
FLEET_SENTINEL_DRY_RUN=true

# Fleet Sentinel proactive sweep interval (hours). Default: every 4 hours.
BUTTERCLAW_SENTINEL_INTERVAL_HOURS=4

# Minimum distinct agents registered before Fleet Sentinel will fire (INSUFFICIENT_DATA guard).
BUTTERCLAW_SENTINEL_MIN_AGENTS=2

# Sliding window (seconds) for collusion role accumulation.
BUTTERCLAW_COLLUSION_WINDOW_SECONDS=180

# Number of distinct agents showing the same pattern to trigger a CorrelationEvent.
BUTTERCLAW_CORRELATION_FLEET_THRESHOLD=3

# Trust propagation depth on taint: 1 (default) or 2. Never automated beyond 2 hops.
BUTTERCLAW_TRUST_PROPAGATION_DEPTH=1

# Asymmetric reputation: taint hits this many times harder than clean-session recovery.
BUTTERCLAW_REPUTATION_DECAY_RATIO=3.0

# Max simultaneous LLM hemisphere calls (Guardian Brain is exempt from this cap).
BUTTERCLAW_MAX_CONCURRENT_LLM=2

# Consecutive LLM errors before circuit breaker opens.
BUTTERCLAW_CIRCUIT_BREAKER_THRESHOLD=3

# Seconds to wait in OPEN state before allowing a half-open probe.
BUTTERCLAW_CIRCUIT_BREAKER_RESET_SECONDS=60

# --- Memory Watchdog (v0.9.2 R3) ---
# Fallback maturation daemon — fires if dream_engine has not ticked within
# MEMORY_MATURATION_FALLBACK_HOURS. Keeps activation scores current even
# when dream_engine is stalled or recovering. All three values mirror the
# _MemoryCfg dataclass defaults and can be tuned here without touching source.
BUTTERCLAW_MEMORY_WATCHDOG_ENABLED=true

# How long (hours) without a dream_engine tick before the watchdog fires and
# logs ⚠️ WARNING. Match or exceed your dream_engine idle cycle interval.
BUTTERCLAW_MEMORY_MATURATION_FALLBACK_HOURS=6.0

# How often (seconds) the watchdog polls the last-tick timestamp.
# Lower values improve shutdown responsiveness; 300 (5 min) is the safe default.
BUTTERCLAW_MEMORY_WATCHDOG_CHECK_INTERVAL_SEC=300

# --- Docker / Python ---
PYTHONUNBUFFERED=1