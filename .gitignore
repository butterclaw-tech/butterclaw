# --- Python Environment ---
.venv/
venv/
env/
bin/
lib/
include/
setuptools.pypa.io/

# --- Python Cache ---
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/

# --- Local Data & Secrets (CRITICAL) ---
# Never commit local SQLite databases or WAL/SHM journals
butterclaw.db
fleet.db
*.db
*.db-wal
*.db-shm
data/
# Never commit local environment variable files or wizard backups
.env
.env.*
!.env.example

# --- SkillGuard Local Packages & Test Fixtures (v0.9.3) ---
# Keep the directory for Docker bind-mounts, ignore local/synthetic payloads
skills/*
!skills/.gitkeep

# --- Logs ---
*.log
openclaw_gateway.log

# --- IDE / Editor Settings ---
.vscode/
.idea/
*.swp
*.swo

# --- OS Specific ---
.DS_Store
Thumbs.db
desktop.ini

# --- Cryptographic Keys & Certs (CRITICAL) ---
*.key
*.pem
*.crt
*.csr
*.p12
*.pfx
nginx/certs/