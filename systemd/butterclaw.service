# =============================================
# ButterClaw v0.8.1 — systemd Service Unit
# =============================================
# Install:
#   cd /opt/butterclaw
#   python3 -m venv .venv
#   ./.venv/bin/pip install .
#   sudo cp systemd/butterclaw.service /etc/systemd/system/
#   sudo cp .env /etc/butterclaw.env
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now butterclaw
#
# Logs: journalctl -u butterclaw -f

[Unit]
Description=ButterClaw, The Agentic SOC
Documentation=https://github.com/butterclaw-tech/butterclaw
After=network.target local-fs.target
Wants=network-online.target

[Service]
Type=simple

# Run as a dedicated, unprivileged user
User=butterclaw
Group=butterclaw
WorkingDirectory=/opt/butterclaw

# Load the Gibson keys and API tokens securely
EnvironmentFile=/opt/butterclaw/.env

# Execute the stdio transport listener
# ExecStart=/opt/butterclaw/venv/bin/python -m butterclaw.core.daemon --transport stdio
ExecStart=/opt/butterclaw/.venv/bin/python -m butterclaw.server
ExecReload=/bin/kill -HUP $MAINPID

# Grant ONLY the specific capabilities needed to monitor and kill rogue agents
# CAP_KILL: Required to issue SIGKILL to rogue processes
# CAP_SYS_PTRACE: Required to read /proc/pid/fd for deep telemetry
CapabilityBoundingSet=CAP_KILL CAP_SYS_PTRACE
AmbientCapabilities=CAP_KILL CAP_SYS_PTRACE

# Completely lock down the file system, only allowing writes to the SQLite vault and logs
ProtectSystem=strict
ReadWritePaths=/opt/butterclaw/data /opt/butterclaw/logs
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictNamespaces=true
NoNewPrivileges=true

# If the daemon crashes, restart it automatically to ensure the shield stays up
Restart=on-failure
RestartSec=5s
TimeoutStopSec=10s

[Install]
WantedBy=multi-user.target