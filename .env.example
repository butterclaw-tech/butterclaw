# ======================================================
# ButterClaw v0.7.2 -- Example Environment Configuration
# ======================================================
# Copy this file to .env and replace placeholders with actual values,
# or run `python setup_wizard.py` for interactive configuration.

# --- Instance Identity ---
BUTTERCLAW_INSTANCE_ID=butterclaw-prod

# --- Server ---
BUTTERCLAW_HOST=0.0.0.0
BUTTERCLAW_PORT=5000
BUTTERCLAW_DEBUG=false
BUTTERCLAW_BASE_URL=https://localhost
# Disable COOKIE_SECURE only for plain-HTTP local dev
BUTTERCLAW_COOKIE_SECURE=true

# --- Database ---
# Use /data/butterclaw.db for Docker, ./butterclaw.db for local
BUTTERCLAW_DB_PATH=/data/butterclaw.db

# --- CORS ---
# Comma-separated list of allowed browser origins
# BUTTERCLAW_CORS_ORIGINS=https://butterclaw.yourdomain.com

# --- Brain / Ollama (Local) ---
# Use http://host.docker.internal:11434 for Docker, http://localhost:11434 for baremetal
BUTTERCLAW_OLLAMA_URL=http://host.docker.internal:11434
BUTTERCLAW_OLLAMA_PATH=/api/chat
BUTTERCLAW_MODEL=butterclaw-optimized:latest

# --- Remote Brain (Google Gemini) ---
# Uncomment and set this to use Google Gemini instead of Ollama
# BUTTERCLAW_GOOGLE_API_KEY=your_google_api_key_here

# --- API Keys ---
# Generate a secure 32+ character string for your bootstrap admin key
BUTTERCLAW_API_KEY=bc_your_secure_random_string_here
# Choose a secret string for ntfy push notifications
BUTTERCLAW_ALERT_NTFY_TOPIC=butterclaw-your-secret-topic

# --- Confidence & Safety ---
BUTTERCLAW_CONFIDENCE_THRESHOLD=85
BUTTERCLAW_MCP_DRY_RUN=true
BUTTERCLAW_DRY_RUN=true

# --- Paranoia Dial ---
# 1=Observe  2=Active Defense  3=Air-Gapped Lockdown
BUTTERCLAW_PARANOIA=2

# --- MCP Transport ---
# Options: stdio, sse
BUTTERCLAW_MCP_TRANSPORT=stdio
# BUTTERCLAW_MCP_SCRIPT=./butterclaw_mcp.py  # Uncomment to override stdio script path
# BUTTERCLAW_MCP_SSE_URL=https://remote-mcp-server.com/sse  # Required if transport=sse
# BUTTERCLAW_MCP_SSE_TOKEN=your_sse_bearer_token  # Required if transport=sse

# --- Authentication ---
BUTTERCLAW_RATE_ADMIN=30
BUTTERCLAW_RATE_OPERATOR=15
BUTTERCLAW_RATE_VIEWER=5
BUTTERCLAW_RATE_INFRASTRUCTURE=1000
BUTTERCLAW_SESSION_TTL=3600
BUTTERCLAW_OAUTH_TTL=600

# --- Alert Dispatcher ---
BUTTERCLAW_ALERT_TIMEOUT=10
BUTTERCLAW_ALERT_RETRIES=3
BUTTERCLAW_ALERT_BACKOFF=1
BUTTERCLAW_AUTH_FAIL_THRESHOLD=5
BUTTERCLAW_AUTH_FAIL_WINDOW=60

# --- Docker / Python ---
PYTHONUNBUFFERED=1